{
  "manifest_version": 3,
  "name": "UBC News - New Tab",
  "version": "1.0.0",
  "description": "A clean news dashboard that replaces your new tab page.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://feeds.bbci.co.uk/*",
    "https://feeds.npr.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
